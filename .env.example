# =============================================================================
# TripNest Environment Variables Template
# Copy this file to .env or configure in your deployment platform (Render, Vercel)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Production Database Configuration (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Supabase Connection Pooler (Required for IPv4 hosts like Render / Vercel):
# Host: aws-0-<region>.pooler.supabase.com (e.g. aws-0-ap-south-1.pooler.supabase.com)
# Port: 5432 (Session mode) or 6543 (Transaction mode)
# Database: postgres
# User: postgres.<your-project-ref> (e.g. postgres.fcthobeoyuugxrzruxlc)
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.fcthobeoyuugxrzruxlc
DB_PASSWORD=your_supabase_db_password_here
DB_SSLMODE=require

# Alternatively, for environments with IPv6 support (Direct connection):
# DB_HOST=db.fcthobeoyuugxrzruxlc.supabase.co
# DB_USER=postgres


# -----------------------------------------------------------------------------
# Spring Security & JWT Configuration
# -----------------------------------------------------------------------------
# A strong, random HMAC-SHA key (minimum 256 bits / 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION=86400000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Frontend URL that is allowed to access the backend API (comma-separated if multiple)
CORS_ORIGIN=https://your-frontend-deployment.vercel.app

# -----------------------------------------------------------------------------
# External APIs (Optional)
# -----------------------------------------------------------------------------
# OpenWeather API Key for live weather forecast on destination cards
OPENWEATHER_API_KEY=your_openweather_api_key_here

# SMTP / Email Notifications (Optional, Gmail or SendGrid SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# -----------------------------------------------------------------------------
# Frontend Environment Variables (Vercel / Next.js)
# Note: Only variables prefixed with NEXT_PUBLIC_ are accessible in the browser.
# NEVER put DB credentials or Supabase service_role keys here!
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-backend-deployment.onrender.com
